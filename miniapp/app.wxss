/* app.wxss - 全局样式 */
page {
  background: #f5f5f5;
  font-family: -apple-system, 'PingFang SC', sans-serif;
  color: #333;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  display: block;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #6c63ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  margin-top: 16rpx;
  border: none;
}

.btn-secondary {
  background: #f0eeff;
  color: #6c63ff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  margin-top: 16rpx;
  border: none;
}

.btn-primary[disabled] { opacity: 0.5; }

.empty {
  text-align: center;
  color: #aaa;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  color: #aaa;
  padding: 40rpx 0;
}

/* 聊天气泡 */
.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 20rpx;
}

.row-nana { flex-direction: row; }
.row-me { flex-direction: row-reverse; }

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 12rpx;
  flex-shrink: 0;
}

.bubble {
  max-width: 60vw;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.bubble-nana {
  background: #fff;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.bubble-me {
  background: #6c63ff;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.bubble.typing { color: #aaa; font-style: italic; }

.msg-time-center {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin: 8rpx 0;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.btn-voice, .btn-send {
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #6c63ff;
  font-weight: 600;
}

/* 任务卡片 */
.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #ddd;
}

.task-card.status-running { border-left-color: #6c63ff; }
.task-card.status-done { border-left-color: #4caf50; }
.task-card.status-failed { border-left-color: #f44336; }

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.task-name { font-weight: 600; font-size: 28rpx; }
.task-status { font-size: 24rpx; color: #888; }
.task-desc { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.task-time { font-size: 22rpx; color: #bbb; }

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.btn-refresh {
  font-size: 26rpx;
  color: #6c63ff;
  padding: 8rpx 16rpx;
}
